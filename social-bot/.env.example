# Copiar a .env y llenar con los valores reales (nunca commitear .env).
# Todos estos los genera Johan en developers.facebook.com — Claude no puede
# crear la app de Meta ni las cuentas (acción a nivel de cuenta, igual que el
# OAuth de Google en lion-platform-api).

PORT=8300

# Cualquier string secreto que tú inventes - Meta te lo va a pedir de vuelta
# al verificar el webhook (paso "Verify Token" en el panel de Meta).
META_VERIFY_TOKEN=

# App Secret de tu app de Meta (Configuracion basica de la app) - se usa para
# validar la firma de cada webhook entrante (X-Hub-Signature-256), asi nadie
# mas que Meta puede mandarte eventos falsos.
META_APP_SECRET=

# Page Access Token de la pagina de Facebook conectada a tu cuenta de
# Instagram profesional (se genera en el panel de la app, con permisos
# instagram_basic, instagram_manage_comments, instagram_manage_messages,
# pages_messaging).
META_PAGE_ACCESS_TOKEN=

# ID numerico de tu cuenta de Instagram profesional/business (Graph API
# Explorer -> GET /me/accounts -> instagram_business_account.id).
IG_BUSINESS_ACCOUNT_ID=
