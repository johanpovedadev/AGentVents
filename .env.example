HUBSPOT_ACCESS_TOKEN=pat-na1-tu-token
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
GEMINI_API_KEY=tu-api-key
# false (o vacío): solicita aprobación en Slack. true: ejecuta acciones CRM automáticamente.
AUTO_APPROVE_ACTIONS=false

# Notificaciones por Telegram (bot Jarvis León / LionTelegram) — se envían en
# paralelo a Slack, no lo reemplazan. Mismo token y chat que usa ese proyecto.
HERMES_BOT_TOKEN=tu_token_de_botfather
HERMES_CHAT_ID=tu_chat_id

# Espejo en Lion Platform (CRM real de Service Store VIP) — solo aplica a
# crear_contacto, que se mapea a un prospecto nuevo. Requiere el backend de
# lion-platform-api corriendo en LION_PLATFORM_BASE_URL.
LION_PLATFORM_BASE_URL=http://localhost:8081/api/v1
LION_EMAIL=super@lionplatform.com
LION_PASSWORD=password123
