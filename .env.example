GEMINI_API_KEY=tu-api-key
# false (o vacío): las acciones que cambian algo (crear prospecto, publicar) piden
# aprobación por Telegram. true: se ejecutan solas (modo autónomo).
AUTO_APPROVE_ACTIONS=false

# Avisos por Telegram (bot Jarvis León). Único canal de notificación.
HERMES_BOT_TOKEN=tu_token_de_botfather
HERMES_CHAT_ID=tu_chat_id

# Lion Platform: CRM, prospectos y LICENCIAS por tenant. El agente entra con la
# cuenta SUPER_ADMIN porque necesita leer /admin/tenants para verificar qué
# productos (CRM, BOT, SOCIAL) tiene cada cliente.
LION_PLATFORM_BASE_URL=http://localhost:8081/api/v1
LION_EMAIL=super@lionplatform.com
LION_PASSWORD=password123

# Base de datos del módulo de redes (esquema "social" en Neon).
DATABASE_URL=postgresql://usuario:clave@host.neon.tech/neondb?sslmode=require
# Solo para una base local de pruebas sin SSL. En Neon dejarlo vacío.
# DATABASE_SSL=false

# Tenant por defecto para el informe de redes y para scripts/addAccount.js.
SOCIAL_TENANT_ID=1

# Meta Graph API: publicar en Facebook/Instagram y leer métricas de Instagram.
# IG_BUSINESS_ACCOUNT_ID es la cuenta de Instagram Business vinculada a la Página.
# IG_ACCESS_TOKEN es opcional; si no está, se usa FB_PAGE_ACCESS_TOKEN.
META_GRAPH_BASE_URL=https://graph.facebook.com/v21.0
FB_PAGE_ID=tu-page-id
FB_PAGE_ACCESS_TOKEN=tu-page-access-token
IG_BUSINESS_ACCOUNT_ID=tu-ig-business-account-id
IG_ACCESS_TOKEN=

# YouTube Data API v3 (API key de Google Cloud, sin OAuth).
YOUTUBE_API_KEY=tu-youtube-api-key
